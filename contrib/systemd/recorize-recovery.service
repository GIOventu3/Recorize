[Unit]
Description=ReCorize recovery menu
DefaultDependencies=no
Conflicts=shutdown.target
After=local-fs.target
Before=shutdown.target

[Service]
Type=simple
ExecStart=/usr/bin/recorize recovery
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/console
TTYReset=yes
TTYVHangup=yes
KillMode=process

[Install]
WantedBy=recorize-recovery.target
